# ==========================================
# APLIKASI NUSAPAY - ENVIRONMENT CONFIG (.env)
# ==========================================

# [KUNCI KEAMANAN & DATABASE]
SECRET_KEY=nusapay_super_secret_key_2026                 # Kunci rahasia untuk enkripsi session & cookie login Flask
DATABASE_URL=mysql+pymysql://root:@localhost/nusapay_db # URI koneksi database MySQL (format: user:pass@host/nama_db)

# ==========================================
# KONFIGURASI FLASK-MAIL (GMAIL SMTP)
# ==========================================
MAIL_SERVER=smtp.gmail.com                               # Alamat server SMTP Gmail untuk mengirim email
MAIL_PORT=587                                            # Port koneksi SMTP TLS (Port standar: 587)
MAIL_USE_TLS=True                                        # Mengaktifkan keamanan enkripsi koneksi TLS
MAIL_USERNAME=nusapaybyfath@gmail.com                    # Alamat email pengirim (akun Gmail sistem)
MAIL_PASSWORD=vbqb uaqq ronn bhak                        # Password aplikasi Gmail 
MAIL_DEFAULT_SENDER=nusapaybyfath@gmail.com              # Nama/alamat email default yang muncul sebagai pengirim